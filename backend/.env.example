# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME="Syelon Wedding API"
APP_VERSION="1.0.0"
DEBUG=true

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite path — file created automatically on first run
DATABASE_URL=sqlite:///./syelon.db

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the React dev server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
